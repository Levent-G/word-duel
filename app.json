{
  "expo": {
    "name": "Word Duel",
    "slug": "word-duel",
    "owner": "leventgulsum",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8FAFC",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.leventgulsum.wordduel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "tr",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.leventgulsum.wordduel",
      "permissions": [
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#36B985"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#36B985"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aaf29dd3-cbb8-465a-9fdf-81e9c60bfa73"
      }
    }
  }
}
